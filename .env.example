# Librarian server-side runtime settings. Values and paths here are placeholders.
# The current scaffold does not consume them until lib/config.ts is implemented.
# Never put production secret values in this file; use scoped Swarm secrets.

# Public application origin and trusted reverse-proxy behavior.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Local paths to secret files. Store local copies under ignored .local/secrets/.
AUTH_SECRET_FILE=.local/secrets/auth-secret
AUTH_ZITADEL_ID=replace-with-zitadel-oidc-client-id
AUTH_ZITADEL_SECRET_FILE=.local/secrets/zitadel-client-secret
AUTH_ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_PROJECT_ID=replace-with-zitadel-project-id
ZITADEL_API_AUDIENCE=replace-with-zitadel-api-audience

# Connect to the existing MongoDB service with a dedicated librarian database
# and least-privilege application user. The URI file contains the credentialed
# connection string; do not put it in this tracked example.
# Shape: mongodb://<app-user>:<password>@<mongo-host>:27017/?authSource=librarian
# Add TLS or replica-set options only when required by the existing deployment.
MONGODB_URI_FILE=.local/secrets/mongodb-uri
MONGODB_DATABASE=librarian

# GitHub App credentials for read-only repository ingestion and signed webhooks.
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY_FILE=.local/secrets/github-app-private-key
GITHUB_WEBHOOK_SECRET_FILE=.local/secrets/github-webhook-secret

# Key used to encrypt OAuth tokens stored by the MongoDB adapter.
OAUTH_TOKEN_ENCRYPTION_KEY_FILE=.local/secrets/oauth-token-encryption-key

# Local scratch storage. Production must set this to the persistent volume mount.
CONTENT_ROOT=.local/content
