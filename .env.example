# Server-only local setup inputs. Place real values only in ignored .env.local.
# Next.js loads .env files; never prefix credentials with NEXT_PUBLIC_.
# Production bootstrap/root credentials still require scoped Swarm secrets or OS/KMS.
# After verified migration, application values below are encrypted in MongoDB and
# managed at /instance/settings. Do not keep stale application values in .env files.

# Legacy startup bootstrap: direct values are supported before encrypted migration.
# Database-first setup can omit these two variables: prepare with --defer-database.
# The UI then creates the protected minimum startup locator before using Mongo settings.
# ABSOLUTELY REQUIRED for legacy startup or operator enrollment; initialized v2 startup uses INSTANCE_DATABASE_FILE.
MONGODB_URI=mongodb://replace-with-host:27017/librarian
# ABSOLUTELY REQUIRED for operator enrollment; initialized v2 startup gets the database name from INSTANCE_DATABASE_FILE.
MONGODB_DATABASE=librarian
# ABSOLUTELY REQUIRED as the protected file-backed alternative to MONGODB_URI when selected.
# MONGODB_URI_FILE=/run/secrets/librarian-mongodb-uri

# ABSOLUTELY REQUIRED: persistent content and snapshots stay outside public/.
CONTENT_ROOT=.local/content

# Legacy import and pre-activation rollback inputs. Keep until owner-confirmed import,
# encrypted readback and continuity checks pass; active v2 never falls back to these.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-at-least-32-random-secret-bytes
AUTH_ZITADEL_ID=replace-with-zitadel-oidc-client-id
AUTH_ZITADEL_SECRET=replace-with-zitadel-client-secret
AUTH_ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_PROJECT_ID=replace-with-zitadel-project-id
ZITADEL_API_AUDIENCE=urn:zitadel:iam:org:project:id:zitadel:aud
GITHUB_APP_ID=replace-with-github-app-id
# Use a quoted multiline RSA private key (or double-quoted escaped newlines).
GITHUB_APP_PRIVATE_KEY="replace-with-github-app-private-key"
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-secret-bytes
# Canonical base64 of exactly 32 random bytes; preserve its exact value on import.
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-canonical-base64-32-byte-key
LIBRARIAN_WORKER_ENABLED=0

# Every credential also accepts its legacy *_FILE counterpart when the direct
# variable is absent. A supplied direct value takes precedence and must validate.
# Never use a missing/invalid direct value to trigger fallback to another secret.

# ABSOLUTELY REQUIRED: selects the matching protected instance marker and control record.
# INSTANCE_DATABASE_FILE=.local/instance/instance-database.json
# ABSOLUTELY REQUIRED: binds this process to the instance host state.
# INSTANCE_ID=<prepared-instance-uuid>
# ABSOLUTELY REQUIRED: trusted origin for setup and provider callbacks.
# INSTANCE_SETUP_ORIGIN=https://docs.example.test
# ABSOLUTELY REQUIRED: host lifecycle and recovery-epoch marker.
# INSTANCE_STATE_FILE=.local/instance/instance-state.json
# ABSOLUTELY REQUIRED: host-held root keys that encrypt MongoDB configuration.
# INSTANCE_KEYRING_FILE=.local/instance/instance-keyring.json
# ABSOLUTELY REQUIRED: protected out-of-band setup and operator authority.
# INSTANCE_OPERATOR_AUTH_FILE=.local/instance/instance-operator-auth.json

# ABSOLUTELY REQUIRED when enabled: host-managed outbound destinations for provider requests.
# INSTANCE_OUTBOUND_POLICY_FILE=.local/instance/outbound-policy.json
# ABSOLUTELY REQUIRED when enabled: host-managed approval state for public catalog publication.
# PUBLIC_CATALOG_APPROVALS_FILE=.local/public-catalog-approvals.json
